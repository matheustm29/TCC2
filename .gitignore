__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Dados brutos e o manifesto que os descreve são artefatos de execução: o
# conteúdo depende de qual fonte estava acessível no momento do download. Fica
# versionado apenas `data/manifesto_referencia.json`, que registra a procedência
# dos dados usados nas tabelas e figuras deste repositório.
data/raw/
data/processed/

# Artefatos de compilação do LaTeX. Os padrões cobrem subdiretórios, porque o
# \include gera um .aux por arquivo incluído, ao lado dele.
tcc2/**/*.aux
tcc2/**/*.bbl
tcc2/**/*.blg
tcc2/**/*.log
tcc2/**/*.out
tcc2/**/*.toc
tcc2/**/*.lof
tcc2/**/*.lot
tcc2/**/*.fls
tcc2/**/*.fdb_latexmk
tcc2/**/*.glo
tcc2/**/*.gls
tcc2/**/*.glg
tcc2/**/*.ist
tcc2/**/*.idx
tcc2/**/*.ind
tcc2/**/*.ilg
tcc2/**/*.nlo
tcc2/**/*.nls
tcc2/**/*.acn*
tcc2/**/*.acr*
tcc2/**/*.alg*
tcc2/**/*.loge
tcc2/**/*.mw
tcc2/**/*.xmpi
tcc2/main.pdf
!tcc2/figuras/*.pdf
!tcc2/PreTexto/**/*.pdf
!tcc2/PosTexto/**/*.pdf
# Convertidos pelo epstopdf a cada compilação. A exclusão precisa vir depois
# das negações acima, que de outro modo os reincluiriam junto com as imagens
# legítimas do modelo.
tcc2/**/*-eps-converted-to.pdf
